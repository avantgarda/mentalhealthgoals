# Copy this file to .env.local, or let `vercel env pull` write one for you.
#
# .env.local is what Next reads first and what the Vercel CLI writes, and it is
# what the test suites and the scripts in ./scripts read. It is gitignored.
# `pnpm setup` will create it for you on a fresh clone.

# PostgreSQL connection string (local dev; Neon/Vercel Postgres in production)
#
# No username on purpose. libpq falls back to your operating-system user, and a
# Homebrew install creates a Postgres role with exactly that name — so this one
# string works for everybody without being edited, which is what lets it live in
# the shared Vercel Development environment.
DATABASE_URL=postgresql://localhost:5432/mentalhealthgoals

# Used to encrypt JWT tokens — any long random string (openssl rand -hex 24)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs against the jobs endpoint.
#
# Not needed. Nothing schedules a job here (`jobs.tasks` is empty and there is
# no cron entry), and with this unset the endpoint denies unauthenticated
# callers outright rather than opening up. Set it if scheduled publishing is
# ever turned on.
#CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate draft preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# ---------------------------------------------------------------------------
# Copying production down to this machine (`pnpm sync:db`, `pnpm sync:media`)
# ---------------------------------------------------------------------------

# Read-only connection string for the production database, used as the SOURCE
# of `pnpm sync:db`. Pull it from the Vercel Development environment rather than
# asking a colleague for it. Use the UNPOOLED string — pg_dump needs a session,
# not a pooler. This is never the database the site writes to: DATABASE_URL
# above is the target, and the sync refuses any target that is not localhost.
#SYNC_DATABASE_URL=postgresql://sync_readonly:...@ep-....neon.tech/...?sslmode=require

# Public base URL of the blob store `pnpm sync:media` downloads from. Not a
# secret and not a credential — the store is public-read. Defaults to the
# production store; point it at a Preview store to pull that one's files.
#BLOB_PUBLIC_BASE_URL=https://xxxxxxxxxxxx.public.blob.vercel-storage.com/

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Admin account created by `pnpm seed` (required — the seed refuses to run
# without them). The seed is on its way out: production is becoming the only
# place content is edited, and these go with it.
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=CHOOSE_A_STRONG_PASSWORD

# Pre-launch only: serve X-Robots-Tag noindex on every page so the draft site
# stays out of search indexes. Delete this (and redeploy) on launch day.
#SITE_NOINDEX=1

# Temporary override for where the contact form's team notification is sent
# (applies at SEED time). Used until enquiries@mentalhealthgoals.co.uk is a
# real mailbox — delete the env var and reseed once M365 email exists.
#CONTACT_NOTIFICATION_EMAIL=someone@example.com

# Resend API key — enables real email sending (password resets, contact-form
# notifications). Without it, emails are written to the server console.
# The sending domain must be verified in Resend first.
#RESEND_API_KEY=re_xxxxxxxxxxxx

# Send every message here instead of its real recipient, whatever the CMS says.
# Set this in Preview and in Development; leave it unset in Production only.
#
# It exists because recipients are not an environment setting: the contact
# form's notification address lives on the form document, so it arrives with
# the database. A preview runs on a branch of production's, and `pnpm sync:db`
# puts production's rows on your laptop — so without this, a test submission
# reaches whoever production would have reached.
#
# A preview deployment with a key and no override sends nothing at all.
#EMAIL_OVERRIDE_RECIPIENT=you@example.com

# Vercel Blob storage for media uploads. Set automatically when you create a
# Blob store on Vercel — only set locally if you want to test Blob uploads.
#BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
