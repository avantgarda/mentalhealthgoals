# PostgreSQL connection string (local dev; Neon/Vercel Postgres in production)
DATABASE_URL=postgresql://your-user@localhost:5432/mentalhealthgoals

# Used to encrypt JWT tokens — any long random string (openssl rand -hex 24)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs against the jobs endpoint
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate draft preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Admin account created by `pnpm seed` (required — the seed refuses to run without them)
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=CHOOSE_A_STRONG_PASSWORD

# Pre-launch only: serve X-Robots-Tag noindex on every page so the draft site
# stays out of search indexes. Delete this (and redeploy) on launch day.
#SITE_NOINDEX=1

# Temporary override for where the contact form's team notification is sent
# (applies at SEED time). Used until enquiries@mentalhealthgoals.co.uk is a
# real mailbox — delete the env var and reseed once M365 email exists.
#CONTACT_NOTIFICATION_EMAIL=someone@example.com

# Resend API key — enables real email sending (password resets, contact-form
# notifications). Without it, emails are written to the server console.
# The sending domain must be verified in Resend first.
#RESEND_API_KEY=re_xxxxxxxxxxxx

# Vercel Blob storage for media uploads. Set automatically when you create a
# Blob store on Vercel — only set locally if you want to test Blob uploads.
#BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
