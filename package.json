{
  "name": "mentalhealthgoals-website",
  "version": "1.0.0",
  "description": "Public website for the Mental Health Goals Programme — mentalhealthgoals.co.uk",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/bootstrap.ts",
    "blobs:mirror": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/blob-mirror.ts",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "build:deploy": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && pnpm build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixture": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local tests/fixtures/load.ts",
    "check:types-drift": "./scripts/check-types-drift.sh",
    "check:migrations": "./scripts/check-migrations.sh",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "seed": "cross-env NODE_ENV=development NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local src/endpoints/seed/run.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "sync:db": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-db.ts",
    "sync:media": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-media.ts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "generate:brand": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/generate-brand-assets.ts",
    "generate:seed-imagery": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/generate-seed-imagery.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@payloadcms/admin-bar": "3.88.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-form-builder": "3.88.0",
    "@payloadcms/plugin-nested-docs": "3.88.0",
    "@payloadcms/plugin-redirects": "3.88.0",
    "@payloadcms/plugin-search": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-vercel-blob": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "1.40.0",
    "next": "16.3.4",
    "next-sitemap": "^4.2.3",
    "payload": "3.88.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.3",
    "@types/escape-html": "^1.0.2",
    "@types/node": "26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vercel/blob": "2.3.1",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.4.1",
    "pg": "8.20.0",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify": "^3.4.13",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "fast-uri": "^3.1.6"
    }
  }
}
